<style>
#char-list{
  display:flex;
  width:fit-content;margin:auto;overflow-x:scroll;
  --bgcl:{{highlight}};
}
/* character list appearance/ordering */
#char-list.float{
  position:absolute;left:1em;
  gap:0.5em;flex-direction:column
}
#char-list.row{
  position:relative;
  gap:1em;flex-direction:row;
}
@media screen and (min-width:1599px) {
  #char-list.dynamic{
    position:absolute;left:1em;
    gap:0.5em;flex-direction:column
  }
}
@media screen and (max-width:1600px) {
  #char-list.dynamic{
    position:relative;
    gap:1em;flex-direction:row;
  }
}
/* character link appearances */
#char-list a{
  border:0;color:white;
  border-radius:5px;
  padding:0.5em
}
#char-list a:hover{background:var(--color-border)}
#char-list .char{
  display:flex;flex-direction:row;
  align-items:center;
  gap:1em;
}
#char-list .char,
#char-list .char>*{flex-shrink:0;}
#char-list .char img{
  width:50px;height:50px;
  object-fit:cover;
  margin:0
}
</style>

<div id="char-list" class="{{layout}}">
{{#each characters}}
  <a class="char" href="https://carrion.chat/character/{{username}}/">
    <img src={{icon}}>
    <span>
      {{#if title}}{{title}}
      {{else}}{{username}}
    {{/if}}</span>
  </a>
{{/each}}
</div>
