<link rel="stylesheet" href="https://file.garden/aTNlS0deYkPxCXcx/css/background.css">

<style>
  .background {
    --background-image: url({{src}});
    --background-fallback: {{color}};
    {{#if (eq repeat-value "repeat")}}
      background-size:auto;
      background-repeat:repeat;
      {{repeat-value}}
    {{/if}}
  }
</style>
<div class="background"></div>
