<style>
#pretentious .query{
  margin: 40vh auto;
  width: fit-content;
  font-family: serif;
  font-weight: bold;
  text-align:left
}
#pretentious .query li{
  list-style-type: '—';
  text-align:left;
  margin: 0 0 0 3em;
  padding: 0 0 0 1em;
}
#pretentious .comp p{margin:0}

#pretentious,
#pretentious .comp p,
#pretentious>details>summary{text-align:center}
#pretentious>details{text-align:justify}
</style>

<div id="pretentious">
<div class="query">

{{{query}}}

<ul>{{#each attributes}}
  <li>{{text}}</li>
{{/each}}</ul>

<div class="comp">

{{{complication}}}
</div>
</div><!-- .query END -->

<img src="{{image}}" />

<details><summary>{{dropdown_title}}</summary>

{{{dropdown_content}}}
</details>
</div><!-- #pretentious END -->
