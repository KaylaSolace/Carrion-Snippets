<style>
#renpy{
  --winbd:#222;
  --wincl:#ccc;
  --gamebg:{{window_bckg_col}};
  --textbg:{{window_bckg_col}}aa;
  --gamecg:url({{window_bckg_img}});
  --sprite-off:{{char_cg_margin}}; 
  max-width:800px;min-width:300px;
  height:720px;margin:auto;overflow:clip;
  border:2px solid var(--winbd);border-radius:10px
}
#renpy .window-title{
  display:flex;position:relative;padding:0.5em 1em;gap:10px;
  justify-content:end;align-items:center;
  background:var(--winbd);color:var(--wincl)
}
#renpy .window-title .t{
  position:absolute;left:0;right:0;
  text-align:center;font-size:12px
}
#renpy .game{
  display:flex;height:100%;position:relative;
  background-color:var(--gamebg);
  background-image:var(--gamecg);
  background-position:center;background-size:cover;
}
#renpy .sprite{
  margin:var(--sprite-off) auto calc(-1 * var(--sprite-off))
}
#renpy .textbox{
  position:absolute;left:1em;right:1em;bottom:3em;height:30%;
  display:flex;flex-direction:column;padding:1em;
  background:var(--textbg);
}
#renpy .textbox>h2{border-bottom:1px solid white}
#renpy .textbox>.msg{flex:1;overflow-y:scroll}
#renpy .history{
  width:fit-content;margin:0 auto;padding:1em;
  overflow-y:scroll
}
#renpy .history[open]{
  display:flex;flex-direction:column-reverse;
  position:absolute;z-index:2;
  margin:0;width:auto;
  left:0;right:0;bottom:0;top:-205%;
}
#renpy .history>summary{text-align:center;padding:0 1em}
#renpy .history[open]>summary{padding:1em}
#renpy .msg{border-bottom:1px solid white}
#renpy .msg:last-of-type{border:0}
#renpy .history .msg{padding: 0.5em 0}
#renpy .history .msg .char{font-weight:bold}
#renpy .history .msg p{display:inline}
@media (max-width:600px){
  #renpy .textbox{height:50%}
  #renpy .history[open]{top:-80%}
}
</style>

<div id="renpy">
<div class="window-title">
  <span class="t">{{window_title}}</span>
  <span>_</span>
  <span>☐</span>
  <span>⨯</span>
</div>
<div class="game">
  <img class="sprite" src="{{char_cg_img}}">
  <div class="textbox">
    <h2>{{final_speaker}}</h2>
    <div class="msg">

      {{{final_message}}}
    </div>
    <details class="history">
      <summary>History</summary>
      {{#each dialogue}}
      <div class="msg">
      <span class="char">{{speaker}}: </span>

      {{{text}}}
      </div>
      {{/each}}
    </details>
  </div>
</div>
</div><!-- #renpy END -->
