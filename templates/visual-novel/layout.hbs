<style>
#renpy{
  --winbd:#222;
  --wincl:#ccc;
  --gamebg:{{window_bckg_col}};
  --gamecg:url({{window_bckg_img}});
  width:800px;height:720px;margin:auto;overflow:clip;
  border:2px solid var(--winbd);border-radius:10px
}
#renpy .window-title{
  display:flex;position:relative;padding:5px 10px;gap:10px;
  justify-content:end;align-items:center;
  background:var(--winbd);color:var(--wincl)
}
#renpy .window-title .t{
  position:absolute;left:0;right:0;
  text-align:center;font-size:12px
}
#renpy .game{
  display:flex;height:100%;
  background-color:var(--gamebg);
  background-image:var(--gamecg);
  background-position:center;background-size:cover;
}
#renpy .sprite{
  margin: {{char_cg_margin}} auto calc(-1 * {{char_cg_margin}});
}
</style>

<div id="renpy">
<div class="window-title">
  <span class="t">{{window_title}}</span>
  <span>_</span>
  <span>☐</span>
  <span>⨯</span>
</div>
<div class="game">
  <img class="sprite" src="{{char_cg_img}}">
</div>
</div><!-- #renpy END -->
